# Copy to .env and edit. Never commit .env.
# All values below are placeholders.

MONEY_TRAIL_ENV=development            # development | test | production
MONEY_TRAIL_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR | CRITICAL

FALKORDB_HOST=<falkordb-host>          # e.g. the compose service host or a managed endpoint
FALKORDB_PORT=<falkordb-port>          # integer, 1-65535
FALKORDB_USERNAME=                     # leave empty if the server has no ACL user
FALKORDB_PASSWORD=<set-a-strong-password>
FALKORDB_TLS=false                     # true to enable TLS
FALKORDB_TLS_CA_CERT=                  # optional path to a CA certificate when TLS is on
FALKORDB_CONNECT_TIMEOUT=5             # seconds, > 0 and <= 120
FALKORDB_SOCKET_TIMEOUT=10             # seconds, > 0 and <= 600
FALKORDB_GRAPH_NAME=<graph-name>       # letters, digits, underscore; starts with a letter

# Used only by the integration tests. Must differ from FALKORDB_GRAPH_NAME.
# Test graphs are created with a unique suffix per run and deleted afterwards.
MONEY_TRAIL_TEST_GRAPH_PREFIX=<test-graph-prefix>

# Optional limits for read-only investigation queries (positive integers).
# A query that needs a limit fails clearly if neither these nor an explicit CLI argument supply it.
# Safety ceilings: results <= 10000, hops <= 10, paths <= 10000.
MONEY_TRAIL_QUERY_MAX_RESULTS=
MONEY_TRAIL_QUERY_MAX_HOPS=
MONEY_TRAIL_QUERY_MAX_PATHS=
MONEY_TRAIL_QUERY_MAX_GAP_MS=
